{
  "name": "scholar-brilliance",
  "compatibility_date": "2026-08-23",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "vars": {
    "SUPABASE_URL": "https://YOUR-PROJECT-REF.supabase.co",
    "SUPABASE_ANON_KEY": "YOUR-PUBLISHABLE-KEY"
  }
}
